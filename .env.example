# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# 서버 전용 — RLS 우회 키. 절대 NEXT_PUBLIC_ 접두사 금지, 클라이언트 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# 카카오맵 JavaScript 키 (Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키)
# Web 플랫폼에 도메인 등록 필요 (예: http://localhost:3000)
NEXT_PUBLIC_MAP_KEY=<kakao-javascript-key>
