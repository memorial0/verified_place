# =============================================================================
# verified_place — 환경변수 예제
#
# 변수 분류:
#   - NEXT_PUBLIC_*  : 빌드타임에 클라이언트 번들로 inline. 값 변경 시 반드시 재빌드.
#   - 그 외          : 런타임(서버 전용). Edge Function / Route Handler 에서만 읽힘.
#
# 로컬 개발에선 키가 비어 있어도 화면은 Mock 데이터로 동작한다(useRestaurants 폴백).
# 단, 지도는 NEXT_PUBLIC_NAVER_CLIENT_ID 가 없거나 도메인 미등록이면 에러 화면이 뜬다.
# =============================================================================

# ── 네이버 지도 (NCP Maps) ───────────────────────────────────────────────────
# 용도:
#   1) 지도 JS SDK 로딩 (src/lib/hooks/useNaverMaps.ts → ncpKeyId)
#   2) /api/directions = Directions 5 자동차 경로 (src/app/api/directions/route.ts)
# 발급:
#   NAVER Cloud Platform → AI·Application Service → Maps → 애플리케이션 등록.
#   애플리케이션의 "Client ID" = ncpKeyId, "Client Secret" 을 그대로 사용한다.
# 도메인:
#   애플리케이션 → Web 서비스 URL 에 사용 도메인(http://localhost:3000,
#   https://verified-place.pages.dev 등)을 모두 등록해야 인증이 통과한다.
NEXT_PUBLIC_NAVER_CLIENT_ID=<ncp-maps-client-id>
NAVER_CLIENT_SECRET=<ncp-maps-client-secret>

# ── Supabase ─────────────────────────────────────────────────────────────────
# 앱이 /api/restaurants 를 통해 식당/카테고리/인증을 조회한다.
# 환경변수가 비어 있으면 API 호출이 실패하고 Mock 데이터로 폴백한다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# 서버 전용 — RLS 우회 키. 절대 NEXT_PUBLIC_ 접두사 금지, 클라이언트 노출 금지.
# 공공 API 수집 / 크롤링 / 대량 upsert 작업(src/lib/ingest/, scripts/)에만 사용.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── 카카오 Local (스크립트 전용, 앱 런타임은 사용하지 않음) ──────────────────
# scripts/geocode-*.mjs · scripts/import-*.mjs 가 식당명 → 좌표/주소 해석에 사용.
# 발급: Kakao Developers → 내 애플리케이션 → 앱 키 > REST API 키.
# Cloudflare/Vercel 환경에는 등록할 필요 없다 (로컬에서만 export).
KAKAO_REST_KEY=<kakao-rest-api-key>
